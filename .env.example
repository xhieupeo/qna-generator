# Google Gemini API (Optional fallback default)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API (Optional fallback default)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# FU Overflow Session Cookie (Optional fallback default)
FUO_COOKIE=your_xf_cookie_here

# Supabase Configuration (Required for Library saving)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


